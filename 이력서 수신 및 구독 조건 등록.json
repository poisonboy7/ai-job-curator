                    "sampleData": {},
                    "sourceCode": {
                      "code": "export const code = async (inputs) => {\n    let list = inputs.current_list;\n    const email = inputs.target_email;\n\n    // 💡 [핵심 교정] 데이터가 문자열(String) 형태로 압축되어 들어왔다면 배열로 강제 파싱(해체)\n    if (typeof list === 'string') {\n        try {\n            list = JSON.parse(list);\n        } catch (e) {\n            // 파싱 실패 시 정규식 등을 고려해 콤마 분리 백업 처리\n            list = list.replace(/[\\[\\]'\"]/g, '').split(',').map(s => s.trim()).filter(Boolean);\n        }\n    }\n\n    // 만약 리스트가 완전히 비어있거나 배열이 아니라면 빈 배열로 초기화\n    if (!Array.isArray(list)) {\n        list = [];\n    }\n\n    // 이제 안전하게 배열 필터 연산 수행 가능\n    const updatedList = list.filter(item => item !== email);\n    \n    console.log(\"[구독 취소 디버그] 기존 리스트:\", list);\n    console.log(\"[구독 취소 디버그] 취소 요청 이메일:\", email);\n    console.log(\"[구독 취소 디버그] 제외 후 리스트:\", updatedList);\n\n    return { updatedList };\n};",
