            "sampleData": {},
            "sourceCode": {
              "code": "// =============================================================\n// 2. Code 노드 - extractedText 매칭 검증 컨트롤러\n// =============================================================\nexport const code = async (inputs) => {\n    console.log(\"[메인 웹훅 디버그] 수신 데이터 확인:\", JSON.stringify(inputs, null, 2));\n\n    const isSubscribe = inputs.subscribe;\n    \n    // 💡 [핵심 교정] Inputs 창에 정의된 'extractedText' 키 이름을 정확하게 매핑합니다.\n    const resumeText = inputs.extractedText || '';\n\n    // [1단계 검문소] 완전히 비어있는 공백 파일/텍스트 검사\n    if (!resumeText || typeof resumeText !== 'string' || resumeText.trim() === '') {\n        // 단, 구독 취소 요청인 경우는 제외\n        if (isSubscribe === false || isSubscribe === 'false' || String(isSubscribe).toLowerCase() === 'false') {\n            return { isPassed: false, message: \"구독 취소 처리가 완벽하게 완료되었습니다.\" };\n        }\n        return {\n            isPassed: false,\n            message: \"이력서 내용이 존재하지 않거나 빈 파일입니다. 정상적인 이력서를 등록해 주세요.\"\n        };\n    }\n\n    // [2단계 검문소] 구독 취소 안전 우회\n    if (isSubscribe === false || isSubscribe === 'false' || String(isSubscribe).toLowerCase() === 'false') {\n        return { isPassed: false, message: \"구독 취소 처리가 완벽하게 완료되었습니다.\" };\n    }\n\n    // [3단계 검문소] 기술 스택 필터링 (추출된 텍스트 기반)\n    const targetKeywords = ['react', 'vue', 'node', 'javascript', 'typescript', 'python', '디자이너', 'ui', 'ux'];\n    const lowerResume = resumeText.toLowerCase();\n    const matchedKeywords = targetKeywords.filter(kw => lowerResume.includes(kw));\n    \n    if (matchedKeywords.length > 0) {\n        return {\n            isPassed: true,\n            message: \"기술 스택 검증 통과 완료. 데이터베이스에 등록합니다.\"\n        };\n    } else {\n        return {\n            isPassed: false,\n            message: \"요구하는 최소 기술 스택 키워드가 발견되지 않았습니다.\"\n        };\n    }\n};",
